#!/usr/bin/env python3
"""Validate the version consumed by Cargo, Python, HA and release tags."""

import json
import sys
import tomllib
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent


def main() -> None:
    cargo = tomllib.loads((ROOT / "Cargo.toml").read_text())["package"]["version"]
    python = tomllib.loads((ROOT / "pyproject.toml").read_text())["project"]["version"]
    app = yaml.safe_load((ROOT / "downloads/config.yaml").read_text())["version"]
    adapter = json.loads((ROOT / "custom_components/downloads/manifest.json").read_text())[
        "version"
    ]
    tests = tomllib.loads((ROOT / "integration/pyproject.toml").read_text())["project"]["version"]
    if not isinstance(app, str) or len({cargo, python, app, adapter, tests}) != 1:
        sys.exit("Cargo, Python and HA release versions differ")
    if len(sys.argv) > 1 and sys.argv[1] != "v" + cargo:
        sys.exit("Release tag differs from the package version")
    print("Release versions agree: " + cargo)


if __name__ == "__main__":
    main()
